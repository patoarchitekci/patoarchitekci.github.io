{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/">
  <channel>
    <title>{{ .Site.Title }} - Newsletter wakacyjny</title>
    <link>{{ .Permalink }}</link>
    <description>Wakacyjny newsletter Patoarchitekci - Pato Summer Short Mail</description>
    <language>{{ .Site.LanguageCode }}</language>
    {{- $base := .Site.BaseURL | strings.TrimSuffix "/" }}
    <atom:link href="{{ $base }}/newsletter-wakacyjny.xml" rel="self" type="application/rss+xml" />
    {{- $pages := where .Site.RegularPages "Section" "newsletter-wakacyjny" }}
    {{- with ($pages.ByDate.Reverse | first 1) }}{{ range . }}{{ if not .Date.IsZero }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}{{ end }}{{ end }}
    {{- range $pages.ByDate.Reverse }}
    {{- $content := .Content | replaceRE "(src|href)=\"/" (printf "${1}=\"%s/" $base) }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ $base }}/</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid isPermaLink="false">newsletter-wakacyjny-{{ .File.ContentBaseName }}</guid>
      <description>{{ with .Params.description }}{{ . | plainify | htmlUnescape }}{{ end }}</description>
      <content:encoded>{{ printf "<![CDATA[" | safeHTML }}{{ $content | safeHTML }}{{ printf "]]>" | safeHTML }}</content:encoded>
    </item>
    {{- end }}
  </channel>
</rss>
